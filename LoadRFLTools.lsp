                     LAYTEXT                                                     ; Text Layer
                     TFLAG                                                       ; Label as Station
                     MASTER                                                      ; Master Scale
                     DIRECTION                                                   ; Direction (1 = Left to Right, -1 = Right to Left)
       )
       (command "._DRAWORDER" (entlast) "" "U" ENT "")
       (entdel ENT)
      )
     )
    )
   )
  )

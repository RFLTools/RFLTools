           (setq Z1 (nth 2 P1))
           (setq P1 (list (nth 0 P1) (nth 1 P1)))
           (setq Z2 (nth 2 P2))
           (setq P2 (list (nth 0 P2) (nth 1 P2)))
           (setq ANG (angle P1 P2))
           (setq D (distance P1 P2))
           (setq Z (min (- Z1 DEPTH) (- Z2 DEPTH)))
           (setq D1 (* SLOPE (- Z1 Z)))
           (setq P (list (+ (nth 0 P1) (* D1 (cos ANG)))
                         (+ (nth 1 P1) (* D1 (sin ANG)))
                         Z
                   )
           )
           (command P)
          )

   (setq INFILE (open CUSTOMFILE "r"))
   (while (/= nil (setq INLINE (read-line INFILE)))
    (setq C 1)
    (setq CUSTOMLIST nil)
    (while (/= nil (setq BLOCKNAME (COLUMN INLINE C ",")))
     (setq CUSTOMLIST (append CUSTOMLIST (list BLOCKNAME)))

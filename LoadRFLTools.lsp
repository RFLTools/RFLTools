         (setq P4 (list (nth 0 P4) (nth 1 P4) 0.0))

         (setq P (inters P1 P2 P3 P4 nil))

         (if (/= P nil)
          (progn
           (if (> (distance P2 P) (distance P1 P))
            (progn
             (setq TMP P1)

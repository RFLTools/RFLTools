 (defun GETOS (/ C OSBEST L P1 P2 P3 P4 TMP ZBEST)
  (setq OSBEST nil ZBEST nil)
  (setq C 0)
  (while (< (+ C 1) (length OGLIST))
   (setq P1 (nth C OGLIST))

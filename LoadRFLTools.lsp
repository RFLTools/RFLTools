                             (function (lambda (e1 e2)
                                               (< (distance e1 PT1)
                                                  (distance e2 PT1)
                                               )
                                       )
                             )
                    )
    )
    (setq PT (car POINTLIST))
    (if (> (distance PT1 PT) 0.0)
     (command (list (nth 0 PT) (nth 1 PT) (+ RFL:PPLINEDELTA (nth 2 PT))))
    )
    (setq PT1 PT)
    (setq POINTLIST (cdr POINTLIST))
   )
   (command "")
  )
 )


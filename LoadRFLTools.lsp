           'paperspace
          )
         )
   )
   (if (= nil (setq TMP (getpoint "\nBase point (0,0,0) : ")))
    (setq PB (list 0.0 0.0 0.0))
    (setq PB TMP)
   )
   (if (= nil (setq TMP (getdist (strcat "\n'X' scale factor (" (rtos 1.0) ") : "))))

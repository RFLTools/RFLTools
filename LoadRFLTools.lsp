       (while (= (cdr (assoc 0 ENTLIST)) "ATTRIB")
        (cond ((or (= (strcase (cdr (assoc 2 ENTLIST))) "ELEV") (= (strcase (cdr (assoc 2 ENTLIST))) "ELEVATION"))
               (setq ELEV2 (atof (if (= (substr (cdr (assoc 1 ENTLIST)) 1 1) "(")

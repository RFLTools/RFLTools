   (setq P4 (list (car P2) (+ Z0 (* L GRADE))))
   (setq TMP (inters P1 P2 P3 P4))
   (if (/= nil TMP)
    (if (= nil OSBEST)
     (setq OSBEST (car TMP) ZBEST (cadr TMP))
     (if (< (abs (car TMP)) (abs OSBEST))
      (setq OSBEST (car TMP) ZBEST (cadr TMP))
     )
    )
   )
   (setq C (+ C 1))
  )
  (list OSBEST ZBEST)
 )
 

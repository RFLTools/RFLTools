                           (if (> DIR 0.0) PB PA)
                           "R"
                           (nth 2 (nth C CORNERLIST))
                  )
                 )
                )
               )
               (progn
               )
              )
              (setq C (+ C 1))
              (setq PA PB)
             )
            )
           )
          )
         )
        )
       )
      )
     )
    )
   )
  )
 )


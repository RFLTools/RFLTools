          )
          (setq SLOPE (cdr (assoc "LSLOPE5" RFL:DUALCARLIST)))
          (setq TMP (/ (* D SLOPE)
                       (+ 1.0 (* SLOPE (* 0.01 SUPERLEFT)))
                    )
          )
          (setq PL8 (list (- (car PL7) TMP)
                          (- (cadr PL7) D (* -1.0 TMP (* 0.01 SUPERLEFT)))

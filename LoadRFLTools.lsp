(defun C:BESTARC (/ *error* ANG1 ANG2 ANGBASE ANGDIR ASKFLAG ATTREQ C C1 C2 CMDECHO E ENT ENTLIST ORTHOMODE OSMODE P P1 P2 PC PLIST R TMP)
 (setq ATTREQ (getvar "ATTREQ"))

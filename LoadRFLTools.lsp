         (command "")
         (command "._3DPOLY")
         (foreach P PLIST
          (progn
           (setq P1 (car P))
           (setq P2 (cadr P))
           (setq Z1 (nth 2 P1))
           (setq P1 (list (nth 0 P1) (nth 1 P1)))
           (setq Z2 (nth 2 P2))
           (setq P2 (list (nth 0 P2) (nth 1 P2)))
           (setq ANG (angle P1 P2))
           (setq D (distance P1 P2))
           (setq Z (min (- Z1 DEPTH) (- Z2 DEPTH)))
           (setq D2 (* SLOPE (- Z2 Z)))
           (setq P (list (- (nth 0 P2) (* D2 (cos ANG)))
                         (- (nth 1 P2) (* D2 (sin ANG)))

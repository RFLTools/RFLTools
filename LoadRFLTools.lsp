 (defun ACCEPTTBAY ()
  (setq CANCEL 0)
  (setq TBAYRADIUS (atof (get_tile "RADIUS")))
  (setq TBAYDELTA (angtof (get_tile "DELTA")))
  (setq TBAYOFFSET (atof (get_tile "OFFSET")))

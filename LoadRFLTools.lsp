          (if (= nil DITCHLEFT)
           (setq TMP (- (cadr PL8) (cdr (assoc "LDFVAL" RFL:DUALCARLIST))))
           (progn
            (setq RFL:PVILIST DITCHLEFT)
            (setq TMP (RFL:ELEVATION STA))
            (setq RFL:PVILIST CVER)

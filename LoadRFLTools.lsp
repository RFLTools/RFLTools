 )
 (if (/= nil ENT)
  (progn
   (setq ENTLIST (entget ENT))
   (if (and (= "RFLTRAIN" (strcase (cdr (assoc 2 ENTLIST)))) (= 1 (cdr (assoc 66 ENTLIST))))
    (progn
     (setq ENT (entnext ENT))
     (setq ENTLIST (entget ENT))
     (while (= "ATTRIB" (cdr (assoc 0 ENTLIST)))
      (setq ATT (cdr (assoc 2 ENTLIST)))

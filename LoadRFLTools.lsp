          )
          (setq PL9 (list (- (car PL8)
                             (* (cdr (assoc "LSLOPE6" RFL:DUALCARLIST))
                                (- (cadr PL8) TMP)
                             )
                          )
                          TMP
                    )
          )
          (setq PL10 (list (- (car PL9) (cdr (assoc "LDW" RFL:DUALCARLIST)))

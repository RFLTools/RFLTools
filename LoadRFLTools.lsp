           (setq P1 (list (+ (- (car PBASE) (car N1) (cdr (assoc "ARCH" RFL:SCHEMATLIST))) STABASE) (+ (cadr PBASE) (cdr (assoc "ARCH" RFL:SCHEMATLIST)))))

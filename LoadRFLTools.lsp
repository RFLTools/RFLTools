     )
     (setq RFL:QUICKTRAINDEF
      (list
       (cons "TITLE" TITLE)
       (cons "RAILCL" RAILCL)
       (cons "GAUGE" GAUGE)
       (cons "WB" WB)
       (cons "OH" OH)
       (cons "LABELIOX" LABELIOX)
       (cons "LABELIOY" LABELIOY)
       (cons "LABELSX" LABELSX)
       (cons "LABELOSX" LABELOSX)
       (cons "LABELOSY" LABELOSY)
       (cons "LTITLEH" LTITLEH)

          )

          (setq D (cdr (assoc "LSD2" RFL:DUALCARLIST)))
          (setq PL12 (list (car PL11) (- (cadr PL11) D)))
          (setq SLOPE (cdr (assoc "LSLOPE2" RFL:DUALCARLIST)))
